% smcbvs.sty -- shared notation and environments for the SMC-BVS paper sections
% (Writing Department). Used by D1 (methodology) and D2 (results). One notation system:
% every symbol defined here is introduced in the text of D1, Section 1, and recalled in D2, Section 2.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{smcbvs}[2026/11/16 SMC-BVS shared notation]

\RequirePackage{amsmath,amssymb,amsthm,mathtools,bm}
\RequirePackage{xcolor}
\RequirePackage{enumitem}
\RequirePackage{booktabs,longtable,array,tabularx}
\RequirePackage[hidelinks]{hyperref}
% cleveref not installed on Owls

% ---------------------------------------------------------------- toggles
% Status notes are for the owner and HQ; \showstatusfalse removes them for submission.
\newif\ifshowstatus \showstatustrue

% ---------------------------------------------------------------- theorem environments
\theoremstyle{plain}
\newtheorem{theorem}{Theorem}[section]
\newtheorem{proposition}[theorem]{Proposition}
\newtheorem{corollary}[theorem]{Corollary}
\newtheorem{lemma}[theorem]{Lemma}
\theoremstyle{definition}
\newtheorem{definition}[theorem]{Definition}
\newtheorem{example}[theorem]{Example}
\theoremstyle{remark}
\newtheorem{remark}[theorem]{Remark}

% ---- Global named assumptions (used by two or more theorems) and conventions.
% Display names are registered once here, so they can be cited before the defining text.
\newcommand{\defasm}[2]{\expandafter\def\csname asmdisp@#1\endcsname{#2}}
\newcommand{\asmdisp}[1]{\csname asmdisp@#1\endcsname}
\defasm{GL}{GL}\defasm{DIM}{DIM}\defasm{GR}{GR}\defasm{SP}{SP}\defasm{BC}{BC}\defasm{BM}{BM}
\defasm{FSb}{FS$_\beta$}\defasm{FSt}{FS$_\theta$}\defasm{EF}{EF}\defasm{NC}{NC}\defasm{EFS}{EF$_\Sigma$}
\defasm{V}{V}\defasm{NL}{NL}
\defasm{C1}{C1}\defasm{C2}{C2}\defasm{C2p}{C2$^+$}\defasm{C3}{C3}
% \begin{assumption}{key}{Name} ... \end{assumption}: prints "Assumption (DISPLAY) (Name)."
\newenvironment{assumption}[2]{%
  \par\smallskip\noindent
  \phantomsection\label{asm:#1}%
  \textbf{Assumption (\asmdisp{#1})} \textit{(#2).}\ \ignorespaces}{\par\smallskip}
% \begin{convention}{key}{Name}: same layout, "Convention (C1)".
\newenvironment{convention}[2]{%
  \par\smallskip\noindent
  \phantomsection\label{asm:#1}%
  \textbf{Convention (\asmdisp{#1})} \textit{(#2).}\ \ignorespaces}{\par\smallskip}
\newcommand{\as}[1]{\hyperref[asm:#1]{\textup{(\asmdisp{#1})}}}
% Local assumptions of one theorem: numbered with the theorem counter, items (a), (b), ...
% cite as Assumption~\ref{asm:start}(b).
\theoremstyle{definition}
\newtheorem{localassumption}[theorem]{Assumption}
\newenvironment{asmitems}{\begin{enumerate}[label=(\alph*),ref=(\alph*),leftmargin=2em,itemsep=2pt]}{\end{enumerate}}

% "What it rules out" line, inside an assumption.
\newcommand{\rulesout}[1]{\par\noindent\hspace*{1.5em}\textit{Rules out:} #1}

% In-words paragraph before a formal statement.
\newcommand{\inwords}[1]{\par\medskip\noindent\textit{In words.} #1\par\smallskip}

% Status note (outside the theorem environment).
\newcommand{\status}[1]{\ifshowstatus\par\noindent
  \fcolorbox{gray!60}{gray!8}{\parbox{\dimexpr\linewidth-2\fboxsep-2\fboxrule}{\footnotesize
  \textsf{Status (internal note, removed for submission):} #1}}\par\medskip\fi}

% ---------------------------------------------------------------- sets and numbers
\newcommand{\R}{\mathbb{R}}
\newcommand{\N}{\mathbb{N}}
\newcommand{\one}{\mathbf{1}}
\newcommand{\ind}[1]{\mathbf{1}\{#1\}}
\newcommand{\set}[1]{[#1]}                 % [p] = {1,...,p}
\newcommand{\abs}[1]{\lvert #1\rvert}
\newcommand{\norm}[1]{\lVert #1\rVert}

