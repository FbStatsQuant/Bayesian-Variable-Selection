#!/usr/bin/env bash
# RESCUE COPY of stage_islands.sbatch (AR-T2 only: --time 1:30:00; fill adds params.N=40000, budget.task_seconds=5400; HQ e8aab325). Original: GENERATED by tools/slurm/p1m_driver.py (dry run); do not edit by hand.
# Submitted only by submit.sh (the manager's). Worst case of this file: 144.0 billed core-h.
#SBATCH --job-name=p1m_OV_W0_T2_islands
#SBATCH --account=commons
#SBATCH --partition=commons
#SBATCH --qos=nots_commons
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=24
#SBATCH --mem=16G
#SBATCH --time=01:30:00
#SBATCH --constraint=sapphirerapids
#SBATCH --export=NONE
#SBATCH --no-requeue
#SBATCH --kill-on-invalid-dep=yes
#SBATCH --output=/home/fb31/SMC_Engineering_Department/scratch/slurm_out/%x_%A_%a.out
#SBATCH --error=/home/fb31/SMC_Engineering_Department/scratch/slurm_out/%x_%A_%a.err
set -euo pipefail
DEPT=/home/fb31/SMC_Engineering_Department
SCR=$DEPT/scripts/OV_W0_T2
BIN=$SCR/bin/smcbvs4
export TMPDIR=$DEPT/scratch/tmp/${SLURM_JOB_ID}
mkdir -p "$TMPDIR"; trap 'rm -rf "$TMPDIR"' EXIT
export OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK}
# INTERFACES §7: --mem-budget = the whole task's memory. 90% of the Slurm allocation leaves room for the runtime (PR37 re-check INFO-2).
MEMB=$(( ${SLURM_MEM_PER_NODE:-0} * 1048576 * 9 / 10 ))
set +u; source "$SCR/env.sh"; set -u          # NOTS modules (GCC 14.3.0 runtime); see env.sh
# fit table: index (1-based) -> run_id
RUNS=(4-AR-n200-r01-T-s1 4-ADJOPP-n200-r01-T-s1)
FIT=${1:?fit index}
RUN_ID=${RUNS[$((FIT-1))]}
RUN=$DEPT/scratch/runs/OV_W0_T2/$RUN_ID
MAN=$SCR/manifests/$RUN_ID
printf '{"stage":"islands","run_id":"%s","job":"%s","task":"%s","host":"%s","start":"%s"}\n' "$RUN_ID" "${SLURM_JOB_ID}" "${SLURM_ARRAY_TASK_ID:-}" "$(hostname -s)" "$(date -u +%FT%TZ)" >> "$DEPT/scratch/runs/OV_W0_T2/starts.jsonl"
if [[ -e $RUN/OUTCOME ]]; then echo "prep outcome $(cat "$RUN/OUTCOME"): nothing to do"; printf '{"stage":"%s","run_id":"%s","skipped":"prep_outcome"}\n' "islands" "$RUN_ID" >> "$DEPT/scratch/runs/OV_W0_T2/ends.jsonl"; exit 0; fi
R=${SLURM_ARRAY_TASK_ID}
python3 "$SCR/p1m_manifest.py" fill --template "$MAN/island.json" --out "$RUN/manifests/island_$R.json" --set params.id=$R --set params.N=40000 --set budget.task_seconds=5400
"$BIN" island --manifest "$RUN/manifests/island_$R.json" --threads "$OMP_NUM_THREADS" --mem-budget "$MEMB" --out "$RUN/island_$R.bin" > "$RUN/log/island_$R.log" 2>&1
printf '{"stage":"islands","run_id":"%s","job":"%s","task":"%s","end":"%s"}\n' "$RUN_ID" "${SLURM_JOB_ID}" "${SLURM_ARRAY_TASK_ID:-}" "$(date -u +%FT%TZ)" >> "$DEPT/scratch/runs/OV_W0_T2/ends.jsonl"
