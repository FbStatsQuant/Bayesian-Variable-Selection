#!/usr/bin/env bash
# stage_t2thr.sbatch -- GC_T2THR (HQ H-47): the two-thread-count check at 1M: ONE island (island 1) of the GC_P pilot re-run at 48 threads (the pilot ran it at 96) on the pilot's own data.bin / setup.bin / calib.bin, same manifest, seed, mem-budget (64 G), binary; REPORT-ONLY. GENERATED by ops (not by the driver).
# Submitted only by submit_t2thr.sh (the manager's GO). Budget ~20 core-h, limit 1:00 (the pilot island 1 took ~700 s at 96 CPUs).
#SBATCH --job-name=p1m_GC_T2THR_island
#SBATCH --account=commons
#SBATCH --partition=commons
#SBATCH --qos=nots_commons
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=48
#SBATCH --mem=64G
#SBATCH --time=01:00:00
#SBATCH --constraint=sapphirerapids
#SBATCH --export=NONE
#SBATCH --no-requeue
#SBATCH --kill-on-invalid-dep=yes
#SBATCH --output=/home/fb31/SMC_Engineering_Department/scratch/slurm_out/%x_%A_%a.out
#SBATCH --error=/home/fb31/SMC_Engineering_Department/scratch/slurm_out/%x_%A_%a.err
set -euo pipefail
DEPT=/home/fb31/SMC_Engineering_Department
SCR=$DEPT/scripts/GC_T2THR
BIN=$SCR/bin/smcbvs4
export TMPDIR=$DEPT/scratch/tmp/${SLURM_JOB_ID}
mkdir -p "$TMPDIR"; trap 'rm -rf "$TMPDIR"' EXIT
export OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK}
# INTERFACES §7: --mem-budget = the whole task's memory (90 % of the Slurm allocation): the SAME 64 G request as the pilot's island tasks, so the same budget (and G)
MEMB=$(( ${SLURM_MEM_PER_NODE:-0} * 1048576 * 9 / 10 ))
set +u; source "$SCR/env.sh"; set -u
RUN_ID=6-AR-n200-r01-V-s1
SRC=$DEPT/scratch/runs/GC_P/$RUN_ID        # the pilot's finished inputs (read-only here)
RUN=$DEPT/scratch/runs/GC_T2THR/$RUN_ID
MAN=$SCR/manifests/$RUN_ID
for f in data.bin setup.bin calib.bin; do [[ -s $SRC/$f ]] || { echo "FATAL: $SRC/$f missing" >&2; exit 66; }; done
[[ ${SLURM_CPUS_PER_TASK} == 48 ]] || { echo "FATAL: this check must run at 48 threads (got ${SLURM_CPUS_PER_TASK})" >&2; exit 66; }
mkdir -p "$RUN/manifests" "$RUN/log"
printf '{"stage":"t2thr","run_id":"%s","job":"%s","task":"%s","host":"%s","threads":%s,"start":"%s"}\n' "$RUN_ID" "${SLURM_JOB_ID}" "${SLURM_ARRAY_TASK_ID:-}" "$(hostname -s)" "${OMP_NUM_THREADS}" "$(date -u +%FT%TZ)" >> "$DEPT/scratch/runs/GC_T2THR/starts.jsonl"
R=1
python3 "$SCR/p1m_manifest.py" fill --template "$MAN/island.json" --out "$RUN/manifests/island_$R.json" --set params.id=$R
"$BIN" island --manifest "$RUN/manifests/island_$R.json" --threads "$OMP_NUM_THREADS" --mem-budget "$MEMB" --out "$RUN/island_$R.bin" > "$RUN/log/island_$R.log" 2>&1
printf '{"stage":"t2thr","run_id":"%s","job":"%s","task":"%s","end":"%s"}\n' "$RUN_ID" "${SLURM_JOB_ID}" "${SLURM_ARRAY_TASK_ID:-}" "$(date -u +%FT%TZ)" >> "$DEPT/scratch/runs/GC_T2THR/ends.jsonl"
