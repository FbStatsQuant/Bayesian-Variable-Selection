+# Coefficients retain penalised path and OLS scoring refit separately.
+coefficient_evidence <- function(rules, B, X, y, tol, alpha = NA_real_) {
+  p <- ncol(X)
+  out <- lapply(seq_len(nrow(rules)), function(i) {
+    row <- rules[i, , drop = FALSE]
+    failed <- identical(row$status, "failed")
+    whole_fit_failed <- is.null(B)
+    pen <- if (whole_fit_failed) rep(NA_real_, p) else if (is.na(row$index)) rep(0, p) else unname(B[, row$index])
+    ols <- rep(NA_real_, p)
+    if (!whole_fit_failed) {
+      expected_support <- if (failed) row$support_audit else row$support
+      if (!identical(support_key(which(pen != 0)), expected_support))
+        stop("saved penalised coefficient support mismatch for ", row$rule_id)
+      if (startsWith(row$rule_id, "ebic")) {
+        ols <- rep(0, p); idx <- parse_key(expected_support)
+        if (length(idx)) {
+          fit <- stats::lm.fit(X[, idx, drop = FALSE], y, tol = tol)
+          if (fit$rank != length(idx) || any(!is.finite(fit$coefficients))) stop("invalid OLS evidence")
+          ols[idx] <- unname(fit$coefficients)
+        }
+      }
+    }
+    list(rule_id = row$rule_id, status = row$status, support = row$support, k = row$k,
+         index = row$index, lambda = row$lambda, alpha = alpha, beta_pen = pen, beta_ols = ols)
+  })
+  names(out) <- rules$rule_id
+  out
+}
