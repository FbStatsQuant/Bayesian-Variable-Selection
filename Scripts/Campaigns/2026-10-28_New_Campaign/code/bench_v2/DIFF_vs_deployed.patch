+  if (length(setdiff(required, names(rows)))) add("missing F3 extra columns")
+  retired <- c("kappa", "ridge", "ridge_resid_max", "ridge_fold_mse", "kappa_min",
+               "kappa_index", "kappa_boundary", "eps_floor", "n_floored")
+  nested_names <- function(x) {
+    if (!is.list(x)) return(character())
+    c(names(x), unlist(lapply(x, nested_names), use.names = FALSE))
+  }
+  if (length(intersect(retired, c(names(rows), nested_names(rds)))))
+    add("retired fields present")
+  vocab <- c(settings$DIAG_FLAG_CODES, settings$DIAG_INFO_CODES)
+  for (codes in rows$diag_codes) {
+    pieces <- if (is.na(codes) || !nzchar(codes)) character() else strsplit(codes, ";", fixed = TRUE)[[1L]]
+    if (length(setdiff(pieces, vocab))) add("code outside vocabulary")
+  }
+  p <- rows$p[1L]
+  coefs <- rds$coefficients
+  if (!is.list(coefs) || !identical(names(coefs), ids)) {
+    add("coefficient evidence missing or misnamed")
+    return(probs)
+  }
+  if (!identical(coefs, rds$fit$coefficients)) add("RDS coefficient copies differ")
+  fit_failed <- all(rows$status == "failed") && all(is.na(rows$diag_flag))
+  for (i in seq_along(ids)) {
+    z <- coefs[[i]]
+    fields <- c("rule_id", "status", "support", "k", "index", "lambda", "alpha", "beta_pen", "beta_ols")
+    if (!is.list(z) || length(setdiff(fields, names(z))) ||
+        !identical(z$rule_id, ids[i]) || !identical(z$status, rows$status[i]) ||
+        length(z$beta_pen) != p || length(z$beta_ols) != p) {
+      add("bad coefficient evidence for ", ids[i]); next
+    }
+    same <- function(a, b) isTRUE(all.equal(a, b, tolerance = 1e-12, check.attributes = FALSE))
+    if (!same(z$support, rows$support[i]) || !same(z$k, rows$k[i]) ||
+        !same(z$index, rows$index[i]) || !same(z$lambda, rows$lambda[i]) || !is.na(z$alpha))
+      add("coefficient metadata mismatch for ", ids[i])
+    if (fit_failed) {
+      if (!all(is.na(z$beta_pen)) || !all(is.na(z$beta_ols))) add("failed fit coefficients not NA")
+      next
+    }
+    key <- if (rows$status[i] == "failed") rows$support_audit[i] else rows$support[i]
+    if (any(!is.finite(z$beta_pen)) || is.na(key) ||
+        !identical(engine$support_key(which(z$beta_pen != 0)), key))
+      add("penalized support mismatch for ", ids[i])
+    if (startsWith(ids[i], "ebic")) {
+      if (any(!is.finite(z$beta_ols))) add("invalid EBIC OLS vector for ", ids[i])
+    } else if (!all(is.na(z$beta_ols))) add("CV OLS vector must be NA")
+  }
+  if (!fit_failed) {
+    d <- rds$fit$diagnostics
+    if (length(setdiff(c("pilot", "keep", "w", "v", "path", "candidates"), names(d))))
+      add("pilot/screen diagnostics missing")
+  }
+  probs
+}
