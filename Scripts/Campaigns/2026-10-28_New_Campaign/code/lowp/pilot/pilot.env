# pilot.env: the only file OPS edits before submitting the LOWP pilot. Sourced by submit_pilot.sh and every slurm/*.sbatch.
# Plain assignments only (no commands). Paths are absolute; nothing outside New_Campaign is written (the bench library is read only).
# The FINAL edited copy is hashed and copied into the run's log folder by submit_pilot.sh (launch/pilot.env): it is part of the evidence.

# ===================== FILL IN (OPS) ======================================================================================
# Module lines. They must EQUAL CONF's v2.2.1 NOTS build (core byte-identical to v2.2) (same R and same compiler as the build that compiled the core), because the
# enumerator's scores must be bit-identical to the SMC scorer. The scripts run `module purge` first, so list the compiler too,
# e.g. MODULES="GCC/13.2.0 R/4.4.1" (NOTS_ENV.md: R/4.4.1 sits under GCC/13.2.0; OPS has not yet test-loaded it).
MODULES=""
# R library path for the LOWP steps (colon separated; must provide Rcpp and digest). Empty = whatever the modules provide.
R_LIBS_LOWP=""
# Optional R_LIBS_USER for the LOWP steps. Empty = leave the login value untouched.
R_LIBS_USER_LOWP=""
# Modules for the benchmarks: R 4.5.2 plus the compiler it was built with (the pinned study library below is an R 4.5.2 library).
MODULES_BENCH=""
# ===========================================================================================================================

# Pinned benchmark study library (R 4.5.2). READ ONLY: it lies under the benchmark freeze (charter section 3): never write, move or chmod.
# It is passed to the benchmark CLI as --library and to R_LIBS; the summary checks that every non-base package resolved from it.
R_LIBS_BENCH="/projects/ml75/fb31/BVS/bench20261019/lib/R452"
# R_LIBS_USER for the benchmark steps: a non-existent folder, so that no user library can shadow the pinned versions. Do not change on NOTS.
R_LIBS_USER_BENCH="/nonexistent_no_user_library"

# Charter section 2 / D7 disk limits that the guard must enforce (guard.sh is OPS-owned; the bundle only CHECKS it, see guard_check.sh):
REQUIRED_CAMP_LIMIT_KB=524288        # campaign home footprint <= 0.5 GiB
REQUIRED_HOME_LIMIT_KB=10066329      # total home usage < 9.6 GiB
PLANNED_HOME_MB_DEFAULT=30           # whole pilot's home footprint, conservative (staged ~11 MB + compile cache 2 to 5 MB)

# Fixed locations
HOME_ROOT="${NC_HOME_ROOT:-/home/fb31/projects/BVS/New_Campaign}"
SCR_ROOT="${NC_SCR_ROOT:-/scratch/fb31/New_Campaign}"
GUARD="${GUARD:-$HOME_ROOT/code/ops/guard.sh}"

# Per-submission names, all derived from STAMP (exported by submit_pilot.sh; format YYYYMMDDTHHMMZ).
# EVERYTHING the pilot stages lives under RUN_HOME (pilot-owned): code, dev inputs, the sealed-study copy. Nothing shared is touched.
if [ -n "${STAMP:-}" ]; then
  PILOT_ID="${STAMP}_lowp_pilot"
  RUN_HOME="$HOME_ROOT/runs/$PILOT_ID"
  CODE="$RUN_HOME/code"
  V221_DIR="$CODE/core/v2_2_1"                     # frozen v2.2.1 tree (core/, study/, tools/, CHANGES); verified against $CODE/core/v2_2_1.SHA256SUMS
  V221_SUMS="$CODE/core/v2_2_1.SHA256SUMS"
  CORE_DIR="$V221_DIR/core"
  PILOT_DIR="$CODE/lowp/pilot"
  ENUM_DIR="$CODE/lowp/enum"
  LOWPR_DIR="$CODE/lowp/R"
  BENCH_DIR="$CODE/bench_lowp"
  LISTS="$PILOT_DIR/lists"
  DEV_STUDY="$RUN_HOME/inputs/lowp_dev"            # dev inputs/ and manifests/ only (no dev truth): --study for enum, SMC and bench with --development
  STUDY="$RUN_HOME/study"                          # sealed-study copy: manifests/, dev/manifests/, truth/ (1,200), dev/truth/ (60), inputs/ (6 pilot datasets)
  LOG_RUN="$SCR_ROOT/logs/$PILOT_ID"               # scratch: ALL logs (slurm outputs, unit logs, timing, reports, receipts)
  CACHE_ROOT="$SCR_ROOT/runs/${PILOT_ID}_cache"    # scratch: compile cache of the enumerator
  TMP_ROOT="$SCR_ROOT/runs/${PILOT_ID}_tmp"        # scratch: per-job TMPDIR
fi
