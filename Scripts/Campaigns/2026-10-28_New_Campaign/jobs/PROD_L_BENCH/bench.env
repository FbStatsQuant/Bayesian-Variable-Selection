# bench.env: the only file OPS edits before submitting the PROD-L benchmark wave (PROD_L_BENCH). Sourced by submit_bench.sh, every slurm/*.sbatch
# and every bundle script. Plain assignments only. The final edited copy is hashed into the wave's launch folder.

# ===================== CONFIRM (OPS) ======================================================================================
# Benchmarks: R 4.5.2 + its compiler (the pinned study library is an R 4.5.2 library). Prefilled with the values the accepted pilot rev 7d
# ran its benchmark arm with (ops/OPS4_PROGRESS.md); OPS confirms them. The scripts `module purge` first.
MODULES_BENCH="GCC/14.3.0 R/4.5.2"
# The reused common.sh also knows a "lowp" module set; this bundle runs only R 4.5.2 steps, so MODULES mirrors MODULES_BENCH.
MODULES="$MODULES_BENCH"
R_LIBS_LOWP=""
R_LIBS_USER_LOWP=""
# ===========================================================================================================================

# Pinned benchmark study library (R 4.5.2). READ ONLY (benchmark freeze, charter section 3): passed as R_LIBS and --library only.
R_LIBS_BENCH="/projects/ml75/fb31/BVS/bench20261019/lib/R452"
R_LIBS_USER_BENCH="/nonexistent_no_user_library"

# Charter section 2 / D7 limits that the OPS-owned guard must enforce (guard_check.sh only CHECKS guard.sh):
REQUIRED_CAMP_LIMIT_KB=524288
# Total-home limit the bundle requires guard.sh to enforce: 9.6 GiB (charter, D7). D40's 9.70 GiB fallback = 10171187 KB may be set here ONLY
# by a recorded HQ decision and only together with OPS's guard.sh HOME_LIMIT_KB; guard_check.sh then probes against the guard's own limit.
REQUIRED_HOME_LIMIT_KB=10066329
# HQ D57 (OPS-4 deployment finding): the stage must be reserved ONCE. OPS reserves it with guard.sh BEFORE staging (JOB.md section 2:
# PLANNED_HOME_MB_STAGE); once extracted it is already in home usage, so the driver asks the guard only for the growth still to come.
PLANNED_HOME_MB_STAGE=75             # pre-staging reservation: inputs 63 MB + manifests 1 MB + code < 1 MB (no truth, no dev)
PLANNED_HOME_MB_MAIN=5               # submission of the main wave, AFTER extraction: bookkeeping only (JOBIDS, launch copies are on scratch)
PLANNED_HOME_MB_WAVE=5               # later waves

# CPU ceilings in BILLED CPUs (D47.4, D49; a request of c CPUs bills 2*ceil(c/2)). The benchmark wave is part of PROD-L's budget.
CEIL_ALONE=132
CEIL_WITHH=68
CEIL_COMBINED=192

# Batch deadline rule (PROD-L DESIGN section 3)
START_SLACK_S=120
KILL_GRACE_S=60
COMMIT_MARGIN_S=120

# Per-piece table. WALL_* is the Slurm --time in seconds AND the runner's PRODL_WALL_S. THR_A_/THR_H_ = %N alone / withH.
WALL_bench=3600;      BUDGET_bench=600;       CPUS_bench=1;      MEM_bench=1G;      THREADS_bench=1;      THR_A_bench=32;      THR_H_bench=16
WALL_benchretry=3600; BUDGET_benchretry=1200; CPUS_benchretry=1; MEM_benchretry=1G; THREADS_benchretry=1; THR_A_benchretry=32; THR_H_benchretry=16

# Fixed locations
HOME_ROOT="${NC_HOME_ROOT:-/home/fb31/projects/BVS/New_Campaign}"
SCR_ROOT="${NC_SCR_ROOT:-/scratch/fb31/New_Campaign}"
GUARD="${GUARD:-$HOME_ROOT/code/ops/guard.sh}"

if [ -n "${STAMP:-}" ]; then
  RID="${STAMP}_lowp_bench"
  PILOT_ID="$RID"                                  # name used by the reused pilot common.sh
  RUN_HOME="$HOME_ROOT/runs/$RID"
  CODE="$RUN_HOME/code"
  BENCH_DIR="$CODE/bench_lowp"                     # frozen r2 tree; verified against $BENCH_SUMS
  BENCH_SUMS="$CODE/bench_lowp.SHA256SUMS"
  PILOT_DIR="$CODE/prod_l_bench"                   # the staged bundle (name kept for the reused common.sh)
  PRODL_DIR="$PILOT_DIR"
  LISTS="$PRODL_DIR/lists"
  STUDY="$RUN_HOME/study"                          # manifests/inputs_manifest_lowp.csv + inputs/ (1,200); NO truth
  LOG_RUN="$SCR_ROOT/logs/$RID"
  CACHE_ROOT="$SCR_ROOT/runs/${RID}_cache"
  TMP_ROOT="$SCR_ROOT/runs/${RID}_tmp"
  RUNID_bench="${STAMP}_lowp_benchres"             # ONE result folder for bench and benchretry
  RUNID_benchretry="$RUNID_bench"
  # The reused common.sh's pilot_require_frozen checks V221_DIR/V221_SUMS; here they point at the frozen benchmark tree.
  V221_DIR="$BENCH_DIR"
  V221_SUMS="$BENCH_SUMS"
fi
