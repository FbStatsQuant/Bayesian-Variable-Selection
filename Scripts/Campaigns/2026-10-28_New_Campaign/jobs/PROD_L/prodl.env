# prodl.env: the only file OPS edits before submitting PROD-L. Sourced by submit_prodl.sh, every slurm/*.sbatch and every bundle script.
# Plain assignments only (no commands). Paths are absolute; nothing outside New_Campaign is written. Reused from the pilot's pilot.env (REUSE.md).
# The FINAL edited copy is hashed and copied into the wave's launch folder by submit_prodl.sh (launch/<wave>/prodl.env): it is part of the evidence.

# ===================== CONFIRM (OPS) ======================================================================================
# Module lines: MUST equal CONF's v2.2.1 NOTS build (the enumerator's scores must be bit-identical to the SMC scorer). Prefilled with the values
# the accepted pilot rev 7d ran with (ops/OPS4_PROGRESS.md); OPS confirms them before submission. The scripts `module purge` first.
MODULES="GCC/14.3.0 R/4.5.2"
R_LIBS_LOWP=""
R_LIBS_USER_LOWP="/opt/apps/software/R/4.5.2-gfbf-2025b/lib64/R/library"
# Not used by PROD-L (no benchmark arm, DESIGN.md section 10); kept so the reused common.sh needs no change.
MODULES_BENCH=""
R_LIBS_BENCH="/projects/ml75/fb31/BVS/bench20261019/lib/R452"
R_LIBS_USER_BENCH="/nonexistent_no_user_library"
# ===========================================================================================================================

# Charter section 2 / D7 limits that the OPS-owned guard must enforce (guard_check.sh only CHECKS guard.sh):
REQUIRED_CAMP_LIMIT_KB=524288        # campaign home footprint <= 0.5 GiB
REQUIRED_HOME_LIMIT_KB=10066329      # total home usage < 9.6 GiB
# HQ D57 (OPS-4 deployment finding, run 20261030T1811Z): the stage is reserved ONCE, before staging (JOB.md section 2); once extracted it is
# already in home usage, so the main-wave submission asks only for the growth still to come.
PLANNED_HOME_MB_STAGE=110            # pre-staging reservation: one shared stage (~100 MiB: code ~15, sealed study 72) (sizing section 5)
PLANNED_HOME_MB_MAIN=10              # main-wave submission AFTER extraction: compile caches 2-5 MB + bookkeeping
PLANNED_HOME_MB_WAVE=5               # later waves (rN, p5) and the P5 scan job: small bookkeeping only

# CPU ceilings in BILLED CPUs (D47.4; a request of c CPUs bills 2*ceil(c/2)):
CEIL_ALONE=132                       # PROD-L alone
CEIL_WITHH=68                        # PROD-L while PROD-H runs
CEIL_COMBINED=192                    # PROD-H + PROD-L

# Batch deadline rule (DESIGN.md section 3)
START_SLACK_S=120
KILL_GRACE_S=60
COMMIT_MARGIN_S=120

# Per-piece table (DESIGN.md sections 3 and 5). WALL_* is the Slurm --time in seconds AND the PRODL_WALL_S the runner uses (one source).
# THR_A_* / THR_H_* = array throttle %N for profile alone / withH. CPUS_* = --cpus-per-task; MEM_* = --mem; THREADS_* = enumerator threads.
WALL_enum20=3600;   BUDGET_enum20=300;   CPUS_enum20=4;   MEM_enum20=1G; THREADS_enum20=4;  THR_A_enum20=1;  THR_H_enum20=1
WALL_enum30=2700;   BUDGET_enum30=600;   CPUS_enum30=16;  MEM_enum30=1G; THREADS_enum30=16; THR_A_enum30=4;  THR_H_enum30=2
WALL_smc=18000;     BUDGET_smc=14700;    CPUS_smc=1;      MEM_smc=2G;    THREADS_smc=1;     THR_A_smc=32;   THR_H_smc=16
WALL_smcrep=18000;  BUDGET_smcrep=14700; CPUS_smcrep=1;   MEM_smcrep=2G; THREADS_smcrep=1;  THR_A_smcrep=32; THR_H_smcrep=16
WALL_p5=32400;      BUDGET_p5=29100;     CPUS_p5=1;       MEM_p5=4G;     THREADS_p5=1;      THR_A_p5=8;     THR_H_p5=4
# P5 scan job (s5_p5scan) time limit, HQ D63 (deployment: job 2496956 timed out at the old fixed 00:30:00 after the 2,400 smc records, never
# reaching the 12,000 smcrep records; observed >= 0.75 s per smc record). The limit scales with the number of records the scan READS:
# n = smc + smcrep units of lists/units.tsv (primaries) + the rows of RUN_HOME/p5/expected.tsv when it exists (the only units that can carry a P5
# retry record, at most one each; Sol narrow check D63: a final scan reads retries too). limit = max(P5SCAN_MIN_S, P5SCAN_BASE_S + n x
# P5SCAN_MS_PER_UNIT / 1000). 2,000 ms = 2x the observed 0.75 s scaled by the larger smcrep records (711 / 588 KiB = 1.21, sizing section 5).
# 14,400 primaries and no expected inventory -> 29,400 s = 08:10:00.
P5SCAN_BASE_S=600
P5SCAN_MS_PER_UNIT=2000
P5SCAN_MIN_S=7200
# SMC allocation passed to the core (per fit; the P5 rerun passes the same PRIMARY values and the adapter doubles them)
SMC_MEM_GB=2
SMC_HOURS=4

# Fixed locations
HOME_ROOT="${NC_HOME_ROOT:-/home/fb31/projects/BVS/New_Campaign}"
SCR_ROOT="${NC_SCR_ROOT:-/scratch/fb31/New_Campaign}"
GUARD="${GUARD:-$HOME_ROOT/code/ops/guard.sh}"

# Per-submission names, all derived from STAMP (exported by submit_prodl.sh; format YYYYMMDDTHHMMZ). Everything staged lives under RUN_HOME.
if [ -n "${STAMP:-}" ]; then
  RID="${STAMP}_lowp_prodL"
  PILOT_ID="$RID"                                  # name used by the reused pilot common.sh
  RUN_HOME="$HOME_ROOT/runs/$RID"
  CODE="$RUN_HOME/code"
  V221_DIR="$CODE/core/v2_2_1"                     # frozen v2.2.1 tree; verified against $V221_SUMS
  V221_SUMS="$CODE/core/v2_2_1.SHA256SUMS"
  CORE_DIR="$V221_DIR/core"
  PILOT_DIR="$CODE/prod_l"                         # the staged bundle (name kept for the reused common.sh)
  PRODL_DIR="$PILOT_DIR"
  ENUM_DIR="$CODE/lowp/enum"
  LOWPR_DIR="$CODE/lowp/R"
  LISTS="$PRODL_DIR/lists"
  STUDY="$RUN_HOME/study"                          # the whole sealed study: manifests/, inputs/ (1,200), truth/ (1,200), dev/{inputs,truth,manifests}
  LOG_RUN="$SCR_ROOT/logs/$RID"                    # scratch: ALL logs (slurm outputs, ledger, inventory, timing, receipts, truth-lock evidence)
  CACHE_ROOT="$SCR_ROOT/runs/${RID}_cache"         # scratch: enumerator compile cache
  TMP_ROOT="$SCR_ROOT/runs/${RID}_tmp"             # scratch: per-job TMPDIR
  RUNID_enum20="${STAMP}_lowp_enum20"              # result folders: $SCR_ROOT/results/<run id>/p0020|p0030/<unit>/
  RUNID_enum30="${STAMP}_lowp_enum30"
  RUNID_smc="${STAMP}_lowp_smc"
  RUNID_smcrep="${STAMP}_lowp_smcrep"
fi
