# git_version.cmake -- run at EVERY build (custom target v4_git_version): writes ${OUT} only when the value changes.
# Value: the 40-hex commit (git rev-parse HEAD) + "-dirty" when tracked files differ from HEAD (git diff-index after an
# index refresh; untracked files are ignored, as with git describe --dirty), or "unknown" outside a git checkout.
execute_process(COMMAND git rev-parse HEAD WORKING_DIRECTORY ${SRC}
                OUTPUT_VARIABLE V OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
if(NOT rc EQUAL 0 OR NOT V)
  set(V "unknown")
else()
  execute_process(COMMAND git update-index -q --refresh WORKING_DIRECTORY ${SRC} OUTPUT_QUIET ERROR_QUIET)
  execute_process(COMMAND git diff-index --quiet HEAD -- WORKING_DIRECTORY ${SRC} RESULT_VARIABLE dirty OUTPUT_QUIET ERROR_QUIET)
  if(NOT dirty EQUAL 0)
    set(V "${V}-dirty")
  endif()
endif()
file(WRITE ${OUT}.tmp "// generated by cmake/git_version.cmake at build time\n#define V4_GIT_COMMIT \"${V}\"\n")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different ${OUT}.tmp ${OUT})
file(REMOVE ${OUT}.tmp)
